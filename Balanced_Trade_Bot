@dataclass
class TokenMetrics:
    age: float
    market_cap_usd: float
    unique_buyers: int
    unique_sellers: int
    total_buy_sol: float
    total_sell_sol: float
    net_volume_sol: float
    buyer_seller_ratio: float
    buyer_advantage: int
    creator_sell_sol: float
    creator_sell_share_pct: float
    top_buyer_share_pct: float
    paid_messages: int


@dataclass
class TokenState:
    mint: str
    symbol: str = ""
    name: str = ""
    creator: str = ""
    launch_monotonic: float = field(default_factory=time.monotonic)
    launch_utc: datetime = field(default_factory=lambda: datetime.now(timezone.utc))

    latest_market_cap_sol: Optional[float] = None
    latest_market_cap_usd: Optional[float] = None
    latest_market_cap_updated_age: Optional[float] = None

    paid_subscribed: bool = False
    paid_subscription_started_utc: Optional[datetime] = None
    paid_subscription_started_monotonic: Optional[float] = None
    paid_subscription_stopped_utc: Optional[datetime] = None
    paid_messages: int = 0

    buyers: Set[str] = field(default_factory=set)
    sellers: Set[str] = field(default_factory=set)
    buyer_sol_volume: DefaultDict[str, float] = field(default_factory=lambda: defaultdict(float))
    total_buy_sol: float = 0.0
    total_sell_sol: float = 0.0
    creator_sell_sol: float = 0.0

    reference_500_market_cap_usd: Optional[float] = None
    reference_500_set_age: Optional[float] = None
    reference_515_market_cap_usd: Optional[float] = None
    snap_515: Optional[TokenMetrics] = None
    snap_530: Optional[TokenMetrics] = None

    probe_started: bool = False
    rejected: bool = False
    evaluated_530: bool = False
    ready_for_entry: bool = False
    entered: bool = False
    closed: bool = False
    rejection_reason: str = ""

    entry_buyers: Set[str] = field(default_factory=set)
    entry_sellers: Set[str] = field(default_factory=set)
    entry_total_buy_sol: float = 0.0
    entry_total_sell_sol: float = 0.0

    def age_seconds(self) -> float:
        return time.monotonic() - self.launch_monotonic

    def current_metrics(self) -> Optional[TokenMetrics]:
        if self.latest_market_cap_usd is None:
            return None

        net_volume = self.total_buy_sol - self.total_sell_sol
        buyer_advantage = len(self.buyers) - len(self.sellers)
        ratio = buyer_seller_ratio(len(self.buyers), len(self.sellers))

        creator_sell_share = 0.0
        if self.total_sell_sol > 0:
            creator_sell_share = (self.creator_sell_sol / self.total_sell_sol) * 100.0

        top_buyer_share = 0.0
        if self.total_buy_sol > 0 and self.buyer_sol_volume:
            top_buyer_share = (max(self.buyer_sol_volume.values()) / self.total_buy_sol) * 100.0

        return TokenMetrics(
            age=self.age_seconds(),
            market_cap_usd=self.latest_market_cap_usd,
            unique_buyers=len(self.buyers),
            unique_sellers=len(self.sellers),
            total_buy_sol=self.total_buy_sol,
            total_sell_sol=self.total_sell_sol,
            net_volume_sol=net_volume,
            buyer_seller_ratio=ratio,
            buyer_advantage=buyer_advantage,
            creator_sell_sol=self.creator_sell_sol,
            creator_sell_share_pct=creator_sell_share,
            top_buyer_share_pct=top_buyer_share,
            paid_messages=self.paid_messages,
        )

    def post_entry_buy_sol(self) -> float:
        return max(0.0, self.total_buy_sol - self.entry_total_buy_sol)

    def post_entry_sell_sol(self) -> float:
        return max(0.0, self.total_sell_sol - self.entry_total_sell_sol)

    def post_entry_new_buyers(self) -> int:
        return len(self.buyers - self.entry_buyers)

    def post_entry_new_sellers(self) -> int:
        return len(self.sellers - self.entry_sellers)


