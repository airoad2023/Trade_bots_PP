# ============================================================
# HELPERS
# ============================================================

def now_utc() -> datetime:
    return datetime.now(timezone.utc)


def safe_float(value: Any, default: Optional[float] = None) -> Optional[float]:
    if value is None:
        return default
    try:
        if isinstance(value, str) and not value.strip():
            return default
        return float(value)
    except Exception:
        return default


def safe_str(value: Any) -> str:
    return "" if value is None else str(value).strip()


def get_first(data: Dict[str, Any], keys: List[str], default: Any = None) -> Any:
    for key in keys:
        if key in data and data[key] is not None:
            return data[key]
    return default


def extract_mint(data: Dict[str, Any]) -> str:
    return safe_str(get_first(data, ["mint", "token", "tokenMint", "token_mint", "contractAddress", "ca"]))


def extract_symbol(data: Dict[str, Any]) -> str:
    return safe_str(get_first(data, ["symbol", "ticker", "tokenSymbol"]))


def extract_name(data: Dict[str, Any]) -> str:
    return safe_str(get_first(data, ["name", "tokenName"]))


def extract_creator(data: Dict[str, Any]) -> str:
    return safe_str(get_first(data, ["creator", "creatorPublicKey", "dev", "deployer", "traderPublicKey", "trader", "user"]))


def extract_trader(data: Dict[str, Any]) -> str:
    return safe_str(get_first(data, ["traderPublicKey", "trader", "user", "wallet", "maker", "account"]))


def extract_tx_type(data: Dict[str, Any]) -> str:
    raw = safe_str(get_first(data, ["txType", "type", "side", "action", "event"])).lower()
    if "buy" in raw:
        return "buy"
    if "sell" in raw:
        return "sell"
    if "create" in raw or "new" in raw:
        return "create"
    if "migration" in raw:
        return "migration"
    return raw


def extract_market_cap_sol(data: Dict[str, Any]) -> Optional[float]:
    return safe_float(get_first(data, [
        "marketCapSol", "market_cap_sol", "currentMarketCapSol",
        "current_market_cap_sol", "marketcapSol", "marketCapSOL"
    ]))


def extract_sol_amount(data: Dict[str, Any]) -> float:
    value = safe_float(get_first(data, [
        "solAmount", "sol_amount", "amountSol", "amount_sol", "vSol", "sol", "nativeAmount"
    ]), default=0.0)
    return float(value or 0.0)


def is_new_token_event(data: Dict[str, Any]) -> bool:
    tx_type = extract_tx_type(data)
    if tx_type == "create":
        return True

    has_mint = bool(extract_mint(data))
    has_creation_fields = any(k in data for k in ["initialBuy", "bondingCurveKey", "name", "symbol"])
    return has_mint and has_creation_fields and tx_type not in {"buy", "sell"}


def buyer_seller_ratio(buyers: int, sellers: int) -> float:
    if sellers <= 0:
        return math.inf if buyers > 0 else 0.0
    return buyers / sellers


def percent_return(entry: float, current: float) -> float:
    if entry <= 0:
        return 0.0
    return ((current / entry) - 1.0) * 100.0


def estimated_sol_cost(messages: int) -> float:
    return (messages / 10000.0) * EST_SOL_COST_PER_10000_MESSAGES


def fmt_ratio(value: float) -> str:
    if math.isinf(value):
        return "inf"
    return f"{value:.2f}"


