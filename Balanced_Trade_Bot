def log_event(event_type: str, mint: str, symbol: str, message: str) -> None:
    print(f"[{event_type}] {symbol or mint}: {message}")
    with EVENTS_CSV.open("a", newline="", encoding="utf-8") as f:
        csv.writer(f).writerow([now_utc().isoformat(timespec="seconds"), event_type, mint, symbol, message])


def log_rejection(token: TokenState, reason: str) -> None:
    token.rejected = True
    token.rejection_reason = reason
    with REJECTIONS_CSV.open("a", newline="", encoding="utf-8") as f:
        csv.writer(f).writerow([
            now_utc().isoformat(timespec="seconds"),
            token.mint,
            token.symbol,
            f"{token.age_seconds():.1f}",
            reason,
            token.paid_messages,
            f"{estimated_sol_cost(token.paid_messages):.8f}",
        ])
    log_event("REJECT", token.mint, token.symbol, reason)


